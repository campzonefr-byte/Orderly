// ============================================
// ORDER MANAGEMENT PLATFORM — CORE SCHEMA
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------- ENUMS -----------

enum StoreSourceType {
  SHOPIFY
  CUSTOM
  MARKETPLACE
}

enum FinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RESTOCKED
  CANCELLED
}

enum OrderStatus {
  NOUVEAU
  CONFIRMATION_EN_COURS
  CONFIRME
  ECHANGE
  A_PREPARER
  EN_PREPARATION
  IMPRIME
  EMBALLE
  A_EXPEDIER
  AU_DEPOT_LIVREUR
  EN_COURS_DE_LIVRAISON
  LIVRE
  PAYE
  RETOUR
  RETOUR_DEPOT
  RETOUR_RECU
  ANNULE
  A_VERIFIER
  ARCHIVE
}

enum UserRole {
  SUPER_ADMIN
  STORE_MANAGER
  STAFF
}
model Upsell {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  triggerProductId String
  triggerProduct   Product  @relation("UpsellTrigger", fields: [triggerProductId], references: [id], onDelete: Cascade)
  isActive         Boolean  @default(true)
  startsAt         DateTime?
  endsAt           DateTime?

  items            UpsellItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId])
  @@index([triggerProductId])
}

model UpsellItem {
  id        String  @id @default(cuid())
  upsellId  String
  upsell    Upsell  @relation(fields: [upsellId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("UpsellItem", fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal @db.Decimal(10, 3)

  @@unique([upsellId, productId])
}
model ProductAlias {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias     String

  createdAt DateTime @default(now())

  @@unique([productId, alias])
  @@index([alias])
}
model QuantityOffer {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int
  priceType  String   @default("FIXED")  // FIXED, PERCENT
  price      Decimal? @db.Decimal(10, 3)
  percent    Decimal? @db.Decimal(5, 2)
  label      String?
  isActive   Boolean   @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())

  @@unique([productId, quantity])
  @@index([productId])
}
// ----------- CORE -----------

model Store {
  id              String          @id @default(cuid())
  name            String
  sourceType      StoreSourceType
  isActive        Boolean         @default(true)
  credentials     Json?
  bundles     Bundle[]
  upsells         Upsell[]
  orders          Order[]
  products        Product[]
  userAccess      UserStoreAccess[]
  deliveryIntegrations DeliveryIntegrationStore[]
  socialAccounts  SocialAccount[]
  shippingRules   ShippingRule[]
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([sourceType])
}
model ShippingRule {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name          String   @default("Livraison standard")
  basePrice     Decimal  @default(7) @db.Decimal(10, 3)
  freeThreshold Decimal? @db.Decimal(10, 3)
  cityOverrides Json?
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId])
}
model Order {
  id                String            @id @default(cuid())
  storeId           String
  store             Store             @relation(fields: [storeId], references: [id])

  externalOrderId   String
  orderNumber       String

  financialStatus   FinancialStatus   @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  orderStatus       OrderStatus       @default(NOUVEAU)
  discountType      String?   // PERCENT, FIXED
  discountValue     Decimal?  @db.Decimal(10, 3)
  discountNote      String?
  discountGrantedBy String?
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  customerPhone2    String?
  shippingAddress   Json?
  billingAddress    Json?

  currency          String            @default("USD")
  subtotal          Decimal           @db.Decimal(10, 2)
  taxTotal          Decimal           @db.Decimal(10, 2) @default(0)
  shippingTotal     Decimal           @db.Decimal(10, 2) @default(0)
  total             Decimal           @db.Decimal(10, 2)
  totalRefunded     Decimal           @db.Decimal(10, 2) @default(0)

  tags              String[]
  notes             String?
  internalNote      String?

  confirmationStatus    String?
  cancellationReason    String?
  cancellationNote      String?
  callAttempts          Json?

  deliveryCompany       String?
  scheduledDeliveryDate DateTime?
  assignedAgentId       String?
  assignedAgentName     String?
  confirmedAt           DateTime?

  lineItems         OrderLineItem[]
  fulfillments      Fulfillment[]
  refunds           Refund[]
  events            OrderEvent[]

  sourceCreatedAt   DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([storeId, externalOrderId])
  @@index([storeId, orderStatus])
  @@index([storeId, createdAt])
  @@index([financialStatus])
  @@index([fulfillmentStatus])
  @@index([orderNumber])
}

model OrderLineItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product? @relation(fields: [productId], references: [id])

  sku           String?
  title         String
  variantTitle  String?
  quantity      Int
  fulfilledQty  Int      @default(0)
  refundedQty   Int      @default(0)
  price         Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([sku])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType String
  payload   Json?
  actor     String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Fulfillment {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id])

  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  status             String
  deliveryPartnerRef String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([orderId])
  @@index([deliveryPartnerRef])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])

  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  lineItems Json?

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ----------- INVENTORY -----------
model Product {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  bundle          Bundle?
  bundleComponents BundleComponent[]
  upsellTriggers  Upsell[]     @relation("UpsellTrigger")
  upsellItems     UpsellItem[] @relation("UpsellItem")
  sku               String
  name              String
  quantityAvailable Int      @default(0)
  reservedQty       Int      @default(0)
  defectiveQty      Int      @default(0)
  lowStockThreshold Int      @default(5)
  reorderQty        Int      @default(0)
  costPrice         Decimal? @db.Decimal(10, 2)
  sellPrice         Decimal? @db.Decimal(10, 2)
  externalId        String?
  imageUrl          String?
  isActive          Boolean  @default(true)

  lineItems         OrderLineItem[]
  stockAlerts       StockAlert[]
  inventoryLogs     InventoryLog[]
  quantityOffers    QuantityOffer[]
  aliases          ProductAlias[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, sku])
  @@index([storeId])
}

model StockAlert {
  id                 String    @id @default(cuid())
  productId          String
  product            Product   @relation(fields: [productId], references: [id])

  thresholdAtTrigger Int
  triggeredAt        DateTime  @default(now())
  resolvedAt         DateTime?

  @@index([productId, resolvedAt])
}

model InventoryLog {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  type           String
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  note           String?
  actor          String?

  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
}

// ----------- DELIVERY -----------

model DeliveryIntegration {
  id          String   @id @default(cuid())
  name        String   @default("Cosmos")
  provider    String   // COSMOS, ARAMEX, TUNISIE_EXPRESS
  credentials Json
  isActive    Boolean  @default(true)
  notes       String?

  stores      DeliveryIntegrationStore[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider])
}

model DeliveryIntegrationStore {
  id              String              @id @default(cuid())
  integrationId   String
  integration     DeliveryIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([integrationId, storeId])
  @@unique([storeId, integrationId])
  @@index([storeId])
}

// ----------- AUTH / ACCESS -----------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         UserRole  @default(STAFF)
  passwordHash String
  permissions  String[]  @default([])
  inviteToken  String?
  inviteExpiry DateTime?
  isActive     Boolean   @default(true)

  storeAccess  UserStoreAccess[]
  notifications Notification[]
  channelMembers ChannelMember[]
  chatMessages   ChatMessage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserStoreAccess {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // mention, stock_alert, scheduled_delivery, reclamation
  title     String
  message   String
  link      String?  // /confirmation?order=xxx
  orderId   String?
  actorName String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}
// ----------- MARKETING -----------

model Segment {
  id          String   @id @default(cuid())
  name        String
  description String?
  rules       Json     // { minOrders, minLtv, inactiveDays, maxReturnRate, cities[], products[], tags[] }
  isSystem    Boolean  @default(false)

  campaigns   Campaign[]
  flows       Flow[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  channel     String   @default("SMS")
  message     String
  segmentId   String?
  segment     Segment? @relation(fields: [segmentId], references: [id])

  status      String   @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED
  scheduledAt DateTime?
  sentAt      DateTime?

  recipientCount Int   @default(0)
  sentCount      Int   @default(0)
  failedCount    Int   @default(0)

  sends       CampaignSend[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model CampaignSend {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  phone      String
  name       String?
  message    String
  status     String   @default("PENDING") // PENDING, SENT, FAILED
  error      String?
  sentAt     DateTime?

  createdAt  DateTime @default(now())

  @@index([campaignId, status])
}

model Flow {
  id          String   @id @default(cuid())
  name        String
  description String?

  trigger     String   // LOW_STOCK, NEW_PRODUCT, INACTIVE_CUSTOMER, AFTER_DELIVERY, ABANDONED
  triggerConfig Json?  // { days: 30, threshold: 5, productId: "..." }

  segmentId   String?
  segment     Segment? @relation(fields: [segmentId], references: [id])

  channel     String   @default("SMS")
  message     String
  delayHours  Int      @default(0)

  isActive    Boolean  @default(false)
  lastRunAt   DateTime?
  totalSent   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger, isActive])
}
// ----------- INTERNAL CHAT -----------

model Channel {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("CHANNEL") // CHANNEL, DM
  isPrivate   Boolean  @default(false)

  members     ChannelMember[]
  messages    ChatMessage[]

  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

model ChannelMember {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime @default(now())
  joinedAt   DateTime @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  text      String
  orderRef  String?  // order number shared in the message

  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

// ----------- SOCIAL (Facebook / Instagram) -----------

model SocialAccount {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  platform      String   // FACEBOOK, INSTAGRAM
  externalId    String   // page id or ig business id
  name          String
  username      String?
  pictureUrl    String?
  accessToken   String
  tokenExpiry   DateTime?
  isActive      Boolean  @default(true)

  comments      SocialComment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([storeId, platform, externalId])
  @@index([storeId])
}

model SocialComment {
  id              String   @id @default(cuid())
  accountId       String
  account         SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  externalId      String   @unique
  parentId        String?

  postId          String
  postMessage     String?
  postPictureUrl  String?
  postType        String?  // POST, AD, REEL, STORY

  authorId        String?
  authorName      String?
  authorPicture   String?

  message         String
  detectedPhone   String?
  detectedName    String?
  detectedCity    String?
  detectedProduct String?
  confidence      Float    @default(0)

  status          String   @default("NEW") // NEW, REVIEWED, CONVERTED, IGNORED
  orderId         String?
  assignedTo      String?
  internalNote    String?

  repliedAt       DateTime?
  replyText       String?

  postedAt        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([accountId, status])
  @@index([postId])
  @@index([postedAt])
}
model Bundle {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId   String   @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  isActive    Boolean  @default(true)

  components  BundleComponent[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

model BundleComponent {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([bundleId, productId])
}